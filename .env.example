# TB Benchmark 运行所需环境变量
# 复制本文件为 .env 并填入真实值

# 远程评测服务器
# 评测服务器（支持密码或密钥两种认证方式，二选一即可）
TB_BENCH_HOST=152.42.223.183
TB_BENCH_USER=root
TB_BENCH_PASSWORD=
TB_BENCH_KEY=

# 大模型 API（用于 psi-agent）
PSI_AI_MODEL=deepseek-v4-flash
PSI_API_BASE=https://api.deepseek.com
PSI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Haitun / psi-agent GitHub 仓库
PSI_AGENT_REPO=https://github.com/genuineknowledge/psi-agent.git

# Haitun / psi-agent 版本（Git branch/tag/commit）
# 发布前测试：改为要测试的分支名，如 feature-login-fix
PSI_AGENT_REF=main

# 可选：评测工作目录（服务器上）
TB_BENCH_WORKDIR=/root/haitun-tb
